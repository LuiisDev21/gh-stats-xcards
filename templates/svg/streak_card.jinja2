<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     style="isolation:isolate" viewBox="0 0 {{ width }} {{ height }}" width="{{ width }}px" height="{{ height }}px"
     direction="ltr" role="img" aria-label="GitHub contribution streak stats">
  <style>
    @keyframes st-currstreak {
      0% { font-size: 3px; opacity: 0.2; }
      80% { font-size: 34px; opacity: 1; }
      100% { font-size: 28px; opacity: 1; }
    }
    @keyframes st-fadein {
      0% { opacity: 0; }
      100% { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .st-ns { animation: none !important; opacity: 1 !important; }
      .st-curr { animation: none !important; font-size: 28px !important; opacity: 1 !important; }
    }
  </style>
  <defs>
    <clipPath id="streak-outer-clip">
      <rect width="{{ width }}" height="{{ height }}" rx="{{ border_rx }}"/>
    </clipPath>
    <mask id="streak-mask-ring-behind-fire">
      <rect width="{{ width }}" height="{{ height }}" fill="white"/>
      <ellipse cx="{{ current_cx }}" cy="{{ mask_ellipse_cy }}" rx="13" ry="18" fill="black"/>
    </mask>
  </defs>
  <g clip-path="url(#streak-outer-clip)">
    <g style="isolation:isolate">
      <rect stroke="{% if hide_border %}#0000{% else %}{{ border_color }}{% endif %}" fill="{{ bg_color }}" rx="{{ border_rx }}"
            x="0.5" y="0.5" width="{{ rect_w }}" height="{{ rect_h }}"/>
    </g>
    <g style="isolation:isolate">
      <line x1="{{ bar_x0 }}" y1="{{ y_bar_top }}" x2="{{ bar_x0 }}" y2="{{ y_bar_bot }}"
            vector-effect="non-scaling-stroke" stroke-width="1" stroke="{{ divider_stroke }}"
            stroke-linejoin="miter" stroke-linecap="square" stroke-miterlimit="3"/>
      <line x1="{{ bar_x1 }}" y1="{{ y_bar_top }}" x2="{{ bar_x1 }}" y2="{{ y_bar_bot }}"
            vector-effect="non-scaling-stroke" stroke-width="1" stroke="{{ divider_stroke }}"
            stroke-linejoin="miter" stroke-linecap="square" stroke-miterlimit="3"/>
    </g>

    {# Total contributions #}
    <g style="isolation:isolate">
      <g transform="translate({{ total_cx }}, {{ y_total[0] }})">
        <text x="0" y="32" stroke-width="0" text-anchor="middle" fill="{{ side_nums }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="700" font-size="28px"
              class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 0.6s">{{ total_value }}</text>
      </g>
      <g transform="translate({{ total_cx }}, {{ y_total[1] }})">
        <text x="0" y="32" stroke-width="0" text-anchor="middle" fill="{{ side_labels }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="400" font-size="14px"
              class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 0.7s">Total Contributions</text>
      </g>
      <g transform="translate({{ total_cx }}, {{ y_total[2] }})">
        <text x="0" y="32" stroke-width="0" text-anchor="middle" fill="{{ dates_color }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="400" font-size="12px"
              class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 0.8s">{{ total_sub }}</text>
      </g>
    </g>

    {# Current streak (label + dates + ring + fire + number on top) #}
    <g style="isolation:isolate">
      <g transform="translate({{ current_cx }}, {{ y_curr_label }})">
        <text x="0" y="32" stroke-width="0" text-anchor="middle" fill="{{ curr_streak_label }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="700" font-size="14px"
              class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 0.9s">Current Streak</text>
      </g>
      <g transform="translate({{ current_cx }}, {{ y_curr_range }})">
        <text x="0" y="21" stroke-width="0" text-anchor="middle" fill="{{ dates_color }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="400" font-size="12px"
              class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 0.9s">{{ current_sub }}</text>
      </g>
      <g mask="url(#streak-mask-ring-behind-fire)">
        <circle cx="{{ current_cx }}" cy="{{ y_ring_cy }}" r="{{ ring_r }}" fill="none" stroke="{{ ring_color }}" stroke-width="5"
                class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 0.4s"/>
      </g>
      <g transform="translate({{ current_cx }}, {{ y_fire_ty }})" stroke-opacity="0"
         class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 0.6s">
        <path d="M 1.5 0.67 C 1.5 0.67 2.24 3.32 2.24 5.47 C 2.24 7.53 0.89 9.2 -1.17 9.2 C -3.23 9.2 -4.79 7.53 -4.79 5.47 L -4.76 5.11 C -6.78 7.51 -8 10.62 -8 13.99 C -8 18.41 -4.42 22 0 22 C 4.42 22 8 18.41 8 13.99 C 8 8.6 5.41 3.79 1.5 0.67 Z M -0.29 19 C -2.07 19 -3.51 17.6 -3.51 15.86 C -3.51 14.24 -2.46 13.1 -0.7 12.74 C 1.07 12.38 2.9 11.53 3.92 10.16 C 4.31 11.45 4.51 12.81 4.51 14.2 C 4.51 16.85 2.36 19 -0.29 19 Z"
              fill="{{ fire_color }}"/>
      </g>
      <g transform="translate({{ current_cx }}, {{ y_curr_num }})">
        <text x="0" y="32" stroke-width="0" text-anchor="middle" fill="{{ curr_streak_num }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="700" font-size="28px"
              class="st-curr" style="animation:st-currstreak 0.6s linear forwards">{{ current_value }}</text>
      </g>
    </g>

    {# Longest streak #}
    <g style="isolation:isolate">
      <g transform="translate({{ longest_cx }}, {{ y_longest[0] }})">
        <text x="0" y="32" stroke-width="0" text-anchor="middle" fill="{{ side_nums }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="700" font-size="28px"
              class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 1.2s">{{ longest_value }}</text>
      </g>
      <g transform="translate({{ longest_cx }}, {{ y_longest[1] }})">
        <text x="0" y="32" stroke-width="0" text-anchor="middle" fill="{{ side_labels }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="400" font-size="14px"
              class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 1.3s">Longest Streak</text>
      </g>
      <g transform="translate({{ longest_cx }}, {{ y_longest[2] }})">
        <text x="0" y="32" stroke-width="0" text-anchor="middle" fill="{{ dates_color }}" stroke="none"
              font-family="&quot;Segoe UI&quot;, Ubuntu, sans-serif" font-weight="400" font-size="12px"
              class="st-ns" style="opacity:0;animation:st-fadein 0.5s linear forwards 1.4s">{{ longest_sub }}</text>
      </g>
    </g>
  </g>
</svg>

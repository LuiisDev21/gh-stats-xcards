<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-label="Top languages by repository">
  <style>
    @keyframes lang-slice-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes lang-legend-in {
      from { opacity: 0; transform: translateX(-6px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .lang-donut path {
      opacity: 0;
      animation: lang-slice-in 0.72s cubic-bezier(0.12, 0.88, 0.2, 1) forwards;
    }
    {% for _ in donut_slices %}
    .lang-donut path:nth-child({{ loop.index }}) { animation-delay: {{ (loop.index0 * 0.1) }}s; }
    {% endfor %}
    .lang-legend g.row {
      opacity: 0;
      animation: lang-legend-in 0.55s cubic-bezier(0.12, 0.88, 0.2, 1) forwards;
    }
    {% for _ in legend_items %}
    .lang-legend g.row:nth-child({{ loop.index }}) { animation-delay: {{ (0.45 + loop.index0 * 0.09) }}s; }
    {% endfor %}
    @media (prefers-reduced-motion: reduce) {
      .lang-donut path,
      .lang-legend g.row {
        animation: none;
        opacity: 1;
      }
    }
  </style>
  <rect x="0.5" y="0.5" rx="{{ corner_radius }}" ry="{{ corner_radius }}" width="{{ width - 1 }}" height="{{ height - 1 }}"
        fill="{{ bg_color }}"
        stroke="{% if hide_border %}transparent{% else %}{{ border_color }}{% endif %}" />

  <text x="22" y="30" fill="{{ title_color }}" font-size="16" font-family="system-ui, Segoe UI, Helvetica, Arial, sans-serif" font-weight="650">
    {{ card_title }}
  </text>
  <text x="22" y="48" fill="{{ text_color }}" font-size="11" font-family="system-ui, Segoe UI, Helvetica, Arial, sans-serif" opacity="0.9">
    {{ subtitle }}
  </text>

  {% if has_language_data %}
  <g class="lang-donut" transform="translate(0 6)">
    {% for slice in donut_slices %}
    <path d="{{ slice.d }}" fill="{{ slice.fill }}" stroke="{{ donut_stroke }}" stroke-width="{{ donut_stroke_width }}" />
    {% endfor %}
  </g>

  <g class="lang-legend">
  {% set legend_start_y = 74 %}
  {% for item in legend_items %}
  {% set ly = legend_start_y + loop.index0 * 22 %}
  <g class="row">
  <rect x="22" y="{{ ly - 8 }}" width="11" height="11" rx="{{ swatch_radius }}" ry="{{ swatch_radius }}" fill="{{ item.color }}" />
  <text x="40" y="{{ ly }}" fill="{{ text_color }}" font-size="12" font-family="system-ui, Segoe UI, Helvetica, Arial, sans-serif">{{ item.name }}</text>
  <text x="{{ legend_percent_x }}" y="{{ ly }}" text-anchor="end" fill="{{ title_color }}" font-size="12" font-family="system-ui, Segoe UI, Helvetica, Arial, sans-serif" font-weight="600">{{ item.percent }}</text>
  </g>
  {% endfor %}
  </g>
  {% else %}
  <text x="{{ width // 2 }}" y="{{ height // 2 }}" text-anchor="middle" fill="{{ text_color }}" font-size="13" font-family="system-ui, Segoe UI, Helvetica, Arial, sans-serif">
    Sin datos de idiomas (repos sin primaryLanguage)
  </text>
  {% endif %}
</svg>
